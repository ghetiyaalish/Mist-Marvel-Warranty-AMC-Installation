<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <record id="email_template_warranty_expiry" model="mail.template">
            <field name="name">Warranty Expiry &amp; AMC Offer</field>
            <field name="model_id" ref="model_ro_warranty"/>
            <field name="subject">Important: Your Warranty for {{ object.product_id.name }} is Expiring</field>
            <field name="email_from">{{ (object.create_uid.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Dear <t t-out="object.partner_id.name"/>,</p>
                    <p>Your warranty for <strong><t t-out="object.product_id.name"/></strong> 
                    is expiring on <strong><t t-out="object.end_date"/></strong>.</p>
                    <p>To ensure uninterrupted service, we recommend upgrading to an 
                    <strong>Annual Maintenance Contract (AMC)</strong>.</p>
                    <p>Contact us today for special AMC rates!</p>
                    <p>Best regards,<br/>MIST MARVEL Team</p>
                </div>
            </field>
        </record>

        <record id="email_template_amc_expiry" model="mail.template">
            <field name="name">AMC Expiry Reminder</field>
            <field name="model_id" ref="model_ro_amc"/>
            <field name="subject">Your AMC for {{ object.product_id.name }} is Expiring Soon</field>
            <field name="email_from">{{ (object.create_uid.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Dear <t t-out="object.partner_id.name"/>,</p>
                    <p>This is a reminder that your Annual Maintenance Contract (AMC) for 
                    <strong><t t-out="object.product_id.name"/></strong> is expiring on 
                    <strong><t t-out="object.end_date"/></strong>.</p>
                    <p>Please contact us to renew it.</p>
                    <p>Best regards,<br/>MIST MARVEL Team</p>
                </div>
            </field>
        </record>

    </data>
</odoo>