<odoo>
    <record id="ir_cron_generate_amc_services" model="ir.cron">
        <field name="name">RO: Generate AMC Service Orders</field>
        <field name="model_id" ref="model_ro_amc"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_service_orders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
    </record>

    <record id="ir_cron_amc_auto_activate" model="ir.cron">
            <field name="name">RO: Auto-Activate AMC Contracts</field>
            <field name="model_id" ref="model_ro_amc"/>
