<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_category_ro_service">
        <field name="name">RO Service</field>
        <field name="description">Manage access to RO Service Management</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_ro_technician" model="res.groups">
        <field name="name">Technician</field>
        <field name="category_id" ref="module_category_ro_service"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_ro_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_ro_service"/>
        <field name="implied_ids" eval="[(4, ref('group_ro_technician'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">
        <record id="rule_ro_service_order_technician" model="ir.rule">
            <field name="name">Service Orders: Personal Only</field>
            <field name="model_id" ref="model_ro_service_order"/>
            <field name="domain_force">[('assigned_to', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_ro_technician'))]"/>
        </record>

        <record id="rule_ro_service_order_manager" model="ir.rule">
            <field name="name">Service Orders: All</field>
            <field name="model_id" ref="model_ro_service_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ro_manager'))]"/>
        </record>

        <record id="rule_ro_installation_technician" model="ir.rule">
            <field name="name">Installation: Personal Only</field>
            <field name="model_id" ref="model_ro_installation"/>
            <field name="domain_force">[('assigned_to', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_ro_technician'))]"/>
        </record>

        <record id="rule_ro_installation_manager" model="ir.rule">
            <field name="name">Installation: All</field>
            <field name="model_id" ref="model_ro_installation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ro_manager'))]"/>
        </record>
    </data>
</odoo>