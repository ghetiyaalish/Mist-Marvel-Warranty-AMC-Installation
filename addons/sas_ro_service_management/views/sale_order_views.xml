<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_ro_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.ro.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//header" position="inside">
                <!-- <field name="is_installation_scheduled" invisible="1"/> -->
                <button name="action_create_installation" 
                        string="Schedule Installation" 
                        type="object" 
                        class="btn-primary"
                        invisible="invoice_count == 0"

                    />
            </xpath>

        </field>
    </record>
</odoo>