<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ro_part_line_legacy_tree" model="ir.ui.view">
        <field name="name">ro.service.part.line.legacy.tree</field>
        <field name="model">ro.service.part.line</field>
        <field name="arch" type="xml">
            <tree string="Technician Parts Report" js_class="ro_dashboard_view" create="false" edit="false">
                <field name="comp_no" string="COMP NO." optional="show"/>
                <field name="complaint_date" string="COMPL. DATE" optional="show"/>
                <field name="date_done" string="CLOSE DATE" optional="show"/>
                <field name="customer_id" string="CUSTOMER NAME" optional="show"/>
                <field name="machine_id" string="ITEM NAME" optional="show"/>
                <field name="service_type" optional="show"/>
                <field name="technician_id" optional="show"/>
                <field name="product_id" string="PART NAME" optional="show"/>
                <field name="qty" sum="Total Qty" optional="show"/>
                <field name="unit_price" string="RATE" optional="show"/>
                <field name="part_amount" string="PART.AMT" sum="Total Amount" optional="show"/>
                <!-- <field name="create_uid" string="USER" optional="hide"/> -->
            </tree>
        </field>
    </record>

    <record id="view_ro_part_line_legacy_search" model="ir.ui.view">
        <field name="name">ro.service.part.line.legacy.search</field>
        <field name="model">ro.service.part.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="technician_id"/>
                <field name="product_id"/>
                <field name="date_done"/>
                <filter string="Today" name="today" domain="[('date_done', '=', context_today())]"/>
                <group expand="0" string="Group By">
                    <filter string="Technician" name="group_tech" context="{'group_by': 'technician_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ro_legacy_parts" model="ir.actions.act_window">
        <field name="name">Technician Pending Parts</field>
        <field name="res_model">ro.service.part.line</field>
        <field name="view_mode">tree,pivot</field>
        <field name="view_id" ref="view_ro_part_line_legacy_tree"/>
        <field name="context">{'search_default_today': 0}</field>
    </record>


