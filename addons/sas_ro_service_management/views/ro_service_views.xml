<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ro_service_order_tree" model="ir.ui.view">
        <field name="name">ro.service.order.tree</field>
        <field name="model">ro.service.order</field>
        <field name="arch" type="xml">
            <!-- <tree>
                <field name="name" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="scheduled_date" optional="show"/>
                <field name="state" optional="show"/>
                <field name="chargeable" optional="show"/>
            </tree> -->

            <tree>
                <field name="name" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="product_id" optional="show"/>
                <field name="partner_address" optional="hide"/> 
                <field name="warranty_id" optional="hide"/>
                <field name="contract_id" optional="hide"/>
                <field name="coverage_start_date" optional="hide" string="Cov. Start"/>
                <field name="coverage_end_date" optional="hide" string="Cov. End"/>
                <field name="scheduled_date" optional="show"/>
                <field name="assigned_to" optional="show"/>
                <field name="issue_type" optional="show"/>
                <field name="state" optional="show" widget="badge" decoration-success="state == 'done'"/>
                <field name="chargeable" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_ro_service_order_search" model="ir.ui.view">
        <field name="name">ro.service.order.search</field>
        <field name="model">ro.service.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                
                <filter string="My Services" name="my_services" domain="[('assigned_to', '=', uid)]"/>
                <filter string="Today" name="today" domain="[('scheduled_date', '=', context_today())]"/>
                <separator/>
                <filter string="Chargeable" name="chargeable" domain="[('chargeable', '=', True)]"/>
                <filter string="Warranty" name="warranty" domain="[('chargeable', '=', False)]"/>
                <separator/>
                <filter string="Open Orders" name="open" domain="[('state', 'not in', ['done', 'cancelled'])]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Customer" name="group_customer" context="{'group_by': 'partner_id'}"/>
                    <filter string="Technician" name="group_tech" context="{'group_by': 'assigned_to'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record> 


    

    <record id="view_ro_service_order_form" model="ir.ui.view">
        <field name="name">ro.service.order.form</field>
        <field name="model">ro.service.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_complete" string="Mark Done" type="object" 
                            invisible="state in ('done','invoiced','cancelled')" class="oe_highlight"/>
                    <button name="action_create_invoice" string="Create Invoice" type="object" 
                            invisible="not chargeable or state in ('invoiced','cancelled','new')"/>
                    <field name="state" widget="statusbar" />
                    <button name="action_reset_to_new"
                        string="Reset to New"
                        type="object"
                        class="btn btn-secondary"
                        modifiers='{"invisible": [["state", "=", "new"]]}'/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="allowed_product_ids" invisible="1"/>
                            <field name="partner_id"/>
                            <field name="partner_address"/>
                            <field name="product_id"  domain="[('id', 'in', allowed_product_ids)]"  />
                            <field name="warranty_id"/>
                            <!-- <field name="warranty_coverage" invisible="not warranty_id"/> -->
                            <field name="contract_id"/>
                            <label for="coverage_start_date" string="Coverage Period"/>
                            <div class="o_row">
                                <field name="coverage_start_date" force_save="1" /> 
                                <span class="o_form_label mx-2">to</span> 
                                <field name="coverage_end_date" force_save="1" />
                            </div>
                        </group>
                        <group>
                            <field name="scheduled_date"/>
                            <field name="assigned_to"/>
                            <field name="issue_type" widget="radio"/>
                            <field name="action_taken"/>
                            <field name="chargeable"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Diagnosis">
                            <field name="diagnosis" placeholder="Root cause analysis..."/>
                            <field name="service_notes" placeholder="Technician notes..."/>
                        </page>
                        <page string="Parts Used">
                            <field name="parts_line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="qty"/>
                                    <field name="qty_chargeable" string="Qty to Bill" decoration-danger="qty_chargeable &gt; 0"/>
                                    <field name="uom_id"/>
                                    <field name="unit_price"/>
                                    <field name="is_chargeable" widget="boolean_toggle"/>
                                    <field name="charge_reason" optional="show"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_ro_service_calendar" model="ir.ui.view">
        <field name="name">ro.service.order.calendar</field>
        <field name="model">ro.service.order</field>
        <field name="arch" type="xml">
            <calendar string="Service Orders" date_start="scheduled_date" color="state">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="assigned_to"/>
            </calendar>
        </field>
    </record>

    <record id="action_ro_service_order" model="ir.actions.act_window">
        <field name="name">Service Orders</field>
        <field name="res_model">ro.service.order</field>
        <field name="view_mode">tree,form,kanban,pivot,calendar,graph,activity</field>
    </record>

    <record id="view_move_form_ro_inherit" model="ir.ui.view">
        <field name="name">account.move.form.ro.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="ro_technician_id" string="Technician (Collection)"/>
            </xpath>
        </field>
    </record>
</odoo>