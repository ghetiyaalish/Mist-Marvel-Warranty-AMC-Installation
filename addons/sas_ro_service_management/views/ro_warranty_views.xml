<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ro_warranty_tree" model="ir.ui.view">
        <field name="name">ro.warranty.tree</field>
        <field name="model">ro.warranty</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="start_date" optional="show"/>
                <field name="end_date" optional="show"/>
                <field name="state" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_ro_warranty_search" model="ir.ui.view">
        <field name="name">ro.warranty.search</field>
        <field name="model">ro.warranty</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                
                <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="Expired" name="expired" domain="[('state', '=', 'expired')]"/>
                <filter string="Expiring Soon (30 Days)" name="expiring_soon" 
                        domain="[('end_date', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d')), ('state', '=', 'active')]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Customer" name="group_customer" context="{'group_by': 'partner_id'}"/>
                    <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_ro_warranty_form" model="ir.ui.view">
        <field name="name">ro.warranty.form</field>
        <field name="model">ro.warranty</field>
        <field name="arch" type="xml">
            <form>
                <header><field name="state" widget="statusbar"/></header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="coverage"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_ro_warranty_calendar" model="ir.ui.view">
        <field name="name">ro.warranty.calendar</field>
        <field name="model">ro.warranty</field>
        <field name="arch" type="xml">
            <calendar string="Warranty Expiry" date_start="end_date" color="state">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
            </calendar>
        </field>
    </record>
    

    <record id="action_ro_warranty" model="ir.actions.act_window">
        <field name="name">Warranties</field>
        <field name="res_model">ro.warranty</field>
        <field name="view_mode">tree,form,kanban,pivot,calendar,graph,activity</field>
    </record>
</odoo>