<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ro_part_line_search" model="ir.ui.view">
        <field name="name">ro.service.part.line.search</field>
        <field name="model">ro.service.part.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="service_order_id"/>
                <group expand="1" string="Group By">
                    <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Service Order" name="group_order" context="{'group_by': 'service_order_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_ro_part_line_pivot" model="ir.ui.view">
        <field name="name">ro.service.part.line.pivot</field>
        <field name="model">ro.service.part.line</field>
        <field name="arch" type="xml">
            <pivot string="Parts Consumption Analysis">
                <field name="product_id" type="row"/>
                <field name="qty" type="measure"/>
                <field name="unit_price" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_ro_part_line_graph" model="ir.ui.view">
        <field name="name">ro.service.part.line.graph</field>
        <field name="model">ro.service.part.line</field>
        <field name="arch" type="xml">
            <graph string="Parts Consumption" type="bar">
                <field name="product_id"/>
                <field name="qty" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_ro_part_reporting" model="ir.actions.act_window">
        <field name="name">Parts Consumption</field>
        <field name="res_model">ro.service.part.line</field>
        <field name="view_mode">pivot,graph,tree</field>
    </record>

    <menuitem id="menu_ro_reporting_root" name="Reporting" parent="menu_ro_root" sequence="30"/>
    
    <menuitem id="menu_ro_part_reporting" name="Parts Analysis" 
              parent="menu_ro_reporting_root" 
              action="action_ro_part_reporting" sequence="1"/>
</odoo>