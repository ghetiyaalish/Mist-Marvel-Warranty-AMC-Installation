<odoo>
    <record id="view_ro_installation_tree" model="ir.ui.view">
        <field name="name">ro.installation.tree</field>
        <field name="model">ro.installation</field>
        <field name="arch" type="xml">
            <!-- <tree>
                <field name="name" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="scheduled_date" optional="show"/>
                <field name="status" optional="show"/>
            </tree> -->

            <tree>
                <field name="name" optional="show"/>
                <field name="partner_id" optional="show" />
                <!-- <field name="installation_type" 
                   widget="badge" 
                   decoration-info="installation_type == 'new'" 
                   decoration-warning="installation_type == 'reinstall'"/> -->
                <field name="product_id" optional="show"/>
                <field name="lot_id" optional="show"/>
                <field name="sale_id" optional="hide"/> <field name="location" optional="hide"/>
                <field name="scheduled_date" optional="show"/>
                <field name="assigned_to" optional="show"/>
                <field name="done_date" optional="show"/>
                <field name="status" optional="show" widget="badge" 
                       decoration-success="status == 'done'" 
                       decoration-info="status == 'assigned'"
                       decoration-muted="status == 'cancelled'"/>

            </tree>
        </field>
    </record>

    <record id="view_ro_installation_search" model="ir.ui.view">
        <field name="name">ro.installation.search</field>
        <field name="model">ro.installation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="assigned_to"/>
                
                <filter string="My Installations" name="my_installations" domain="[('assigned_to', '=', uid)]"/>
                <filter string="Today" name="today" domain="[('scheduled_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('scheduled_date', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <separator/>
                <filter string="Planned" name="planned" domain="[('status', '=', 'planned')]"/>
                <filter string="Done" name="done" domain="[('status', '=', 'done')]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Customer" name="group_customer" context="{'group_by': 'partner_id'}"/>
                    <filter string="Technician" name="group_tech" context="{'group_by': 'assigned_to'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

