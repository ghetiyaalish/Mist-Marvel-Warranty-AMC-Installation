    <record id="view_ro_installation_form" model="ir.ui.view">
        <field name="name">ro.installation.form</field>
        <field name="model">ro.installation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_done" string="Mark Done" type="object" 
                            invisible="status == 'done'" class="oe_highlight"/>
                    
                    <button name="action_create_invoice" 
                            string="Create Invoice" 
                            type="object" 
                            class="btn-primary"
                            invisible="not installation_line_ids or invoice_id"/>
                            
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="invoice_id" invisible="1"/>

                        <button name="action_view_invoice"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-pencil-square-o"
                                invisible="not invoice_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Invoice</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    
                    <group>
                        <group>
                            <!-- <field name="installation_type" widget="radio" options="{'horizontal': true}"/> -->
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="lot_id" context="{'default_product_id': product_id}"/> 
                            <field name="sale_id"/>
                            <field name="location"/> 
                        </group>
                        <group>
                            <field name="scheduled_date"/>
                            <field name="assigned_to"/>
                            <field name="done_date" readonly="1"/> 
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Extra Parts / Order Lines">
                            <field name="installation_line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="qty"/>
                                    <field name="unit_price" widget="monetary"/>
                                    <field name="subtotal" widget="monetary" sum="Total"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Details">
                            <group>
                                <field name="remarks" placeholder="Technician Remarks..."/>
                                <field name="installation_photo" widget="image" options="{'size': [150, 150]}"/>
                            </group>
                        </page>
                        <page string="Sign-off"> 
                            <group>
                                <field name="customer_signature" widget="signature"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_ro_installation_calendar" model="ir.ui.view">
        <field name="name">ro.installation.calendar</field>
        <field name="model">ro.installation</field>
        <field name="arch" type="xml">
            <calendar string="Installations" date_start="scheduled_date" color="status">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="assigned_to"/>
            </calendar>
        </field>
    </record>

    <record id="action_ro_installation_order" model="ir.actions.act_window">
        <field name="name">Installation Orders</field>
        <field name="res_model">ro.installation</field>
        <field name="view_mode">tree,form,kanban,pivot,calendar,graph,activity</field>
    </record>

    <record id="action_ro_reinstallation" model="ir.actions.act_window">
        <field name="name">Re-Installation / Shifting</field>
        <field name="res_model">ro.installation</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('installation_type', '=', 'reinstall')]</field>
        <field name="context">{'default_installation_type': 'reinstall'}</field>
    </record>

    <menuitem id="menu_ro_reinstallation"
              name="Reinstallation"
              parent="menu_ro_operations" 
              action="action_ro_reinstallation"
              sequence="20"/>

    <record id="view_ro_installation_form_reinstall" model="ir.ui.view">
        <field name="name">ro.installation.form.reinstall</field>
        <field name="model">ro.installation</field>
        <field name="inherit_id" ref="view_ro_installation_form"/> 
        <field name="arch" type="xml">

            <xpath expr="//field[@name='sale_id']" position="attributes">
                <attribute name="invisible">installation_type == 'reinstall'</attribute>
            </xpath>
            
            <xpath expr="//field[@name='location']" position="after">
                <field name="new_shifting_address" 
                    string="New Address (Shift To)"
                    placeholder="Enter the new location address here..."
                    invisible="installation_type == 'new'" 
                    required="installation_type == 'reinstall'"/> 
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="installation_type" invisible="1"/>
            </xpath>

        </field>
    </record>

    <record id="view_ro_installation_tree_reinstall" model="ir.ui.view">
        <field name="name">ro.installation.tree.reinstall</field>
        <field name="model">ro.installation</field>
        <field name="inherit_id" ref="view_ro_installation_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="installation_type" optional="hide"/>
                <field name="new_shifting_address" optional="hide" string="Shift To"/>
            </field>
        </field>
    </record>


</odoo>