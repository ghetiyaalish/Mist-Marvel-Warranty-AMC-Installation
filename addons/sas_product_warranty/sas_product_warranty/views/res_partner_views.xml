<odoo>
    <record id="view_partner_form_inherit_warranty_products" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.warranty.products</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page string="Products">
                     <field name="product_purchase_ids">
                        <tree create="0" edit="0" delete="0">
                            <field name="product_id"/>
                            <field name="order_date"/>
                            <field name="warranty_duration"/>
                            <field name="warranty_expiry"/>
                            <field name="lot_ids" context="{'default_product_id': product_id}" mode="tree,kanban">
                                <tree>
                                    <field name="name"/>
                                    <field name="product_id"/>
                                </tree>
                            </field>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
